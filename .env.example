# Backend
APP_NAME=secure-open-source-devops
APP_ENV=development
APP_DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database
POSTGRES_USER=devops_user
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=secure_devops
DATABASE_URL=postgresql+psycopg://devops_user:changeme_in_production@db:5432/secure_devops

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_in_production

# GitHub (least-privilege token, never commit real values)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Security scanning
TRIVY_TIMEOUT=300
SEMGREP_TIMEOUT=300
GITLEAKS_TIMEOUT=300

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
